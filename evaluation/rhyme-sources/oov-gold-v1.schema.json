{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "oov-gold-v1.schema.json",
  "title": "Independent OOV pronunciation gold set v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "authored_at", "independence", "evidence_sources", "cases"],
  "properties": {
    "schema_version": { "const": 1 },
    "authored_at": { "type": "string", "format": "date-time" },
    "independence": { "type": "string", "minLength": 1 },
    "evidence_sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "url", "scope"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "format": "uri" },
          "scope": { "type": "string", "minLength": 1 }
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 250,
      "maxItems": 250,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "surface", "normalized", "accepted_pronunciations", "category", "region", "evidence", "adjudication", "legacy_cmu"],
        "properties": {
          "id": { "type": "string", "pattern": "^oov-[0-9]{3}$" },
          "surface": { "type": "string", "minLength": 1 },
          "normalized": { "type": "string", "minLength": 1 },
          "accepted_pronunciations": {
            "type": "array",
            "items": { "type": "string", "pattern": "^[A-Z0-9]+(?: [A-Z0-9]+)*$" }
          },
          "category": { "enum": ["dropped-sound", "apostrophe-variant", "fused-phrase", "stylized-spelling", "colloquialism", "ad-lib", "proper-name-place-acronym", "ambiguous-negative"] },
          "region": { "type": "string", "minLength": 1 },
          "evidence": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "adjudication": {
            "type": "object",
            "additionalProperties": false,
            "required": ["state", "rationale"],
            "properties": {
              "state": { "enum": ["accepted", "rejected-ambiguous", "disputed-invalid"] },
              "rationale": { "type": "string", "minLength": 1 }
            }
          },
          "legacy_cmu": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status", "matches"],
            "properties": {
              "status": { "enum": ["unchecked", "confirmed-oov", "present-in-legacy-cmu"] },
              "matches": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    }
  }
}
