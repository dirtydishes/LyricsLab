{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lyricslab.rhyme-ios-evidence/v1",
  "type": "object",
  "required": ["schemaVersion", "device", "build", "airplaneMode", "benchmark", "writerReview", "cases", "attestation"],
  "properties": {
    "schemaVersion": { "const": "lyricslab.rhyme-ios-evidence/v1" },
    "device": { "type": "object", "additionalProperties": false, "required": ["udid", "name", "model", "osVersion", "physical"], "properties": { "udid": { "type": "string", "pattern": "^[A-Fa-f0-9-]{8,64}$" }, "name": { "type": "string", "minLength": 1 }, "model": { "type": "string", "minLength": 1 }, "osVersion": { "type": "string", "minLength": 1 }, "physical": { "const": true } } },
    "build": { "type": "object", "additionalProperties": false, "required": ["configuration", "diagnosticsEnabled", "appVersion", "bundleIdentifier", "gitCommit", "artifactSha256", "manifestSha256", "buildFingerprintSha256", "builtAt"], "properties": { "configuration": { "const": "Release" }, "diagnosticsEnabled": { "const": true }, "appVersion": { "type": "string", "minLength": 1 }, "bundleIdentifier": { "const": "com.dirtydishes.lyricslab-mobile.diagnostics" }, "gitCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" }, "artifactSha256": { "$ref": "#/$defs/hash" }, "manifestSha256": { "$ref": "#/$defs/hash" }, "buildFingerprintSha256": { "$ref": "#/$defs/hash" }, "builtAt": { "$ref": "#/$defs/timestamp" } } },
    "airplaneMode": { "type": "object", "additionalProperties": false, "required": ["enabled", "attestedBy", "timestamp", "evidenceSha256"], "properties": { "enabled": { "const": true }, "attestedBy": { "type": "string", "minLength": 1 }, "timestamp": { "$ref": "#/$defs/timestamp" }, "evidenceSha256": { "$ref": "#/$defs/hash" } } },
    "benchmark": { "type": "object", "additionalProperties": false, "required": ["reportSha256", "interval", "samples", "warmupsDiscarded", "coldLoadMs", "p50Ms", "p95Ms", "maxMs", "pass"], "properties": { "reportSha256": { "$ref": "#/$defs/hash" }, "interval": { "const": "selection-context-received-to-first-react-committed-suggestion-frame" }, "samples": { "const": 60 }, "warmupsDiscarded": { "type": "integer", "minimum": 20 }, "coldLoadMs": { "type": "number", "minimum": 0 }, "p50Ms": { "type": "number", "minimum": 0, "exclusiveMaximum": 50 }, "p95Ms": { "type": "number", "minimum": 0, "exclusiveMaximum": 100 }, "maxMs": { "type": "number", "minimum": 0 }, "pass": { "const": true } } },
    "writerReview": { "type": "object", "additionalProperties": false, "required": ["packetSha256", "decisionLogSha256", "accepted", "signedBy", "signedAt"], "properties": { "packetSha256": { "$ref": "#/$defs/hash" }, "decisionLogSha256": { "$ref": "#/$defs/hash" }, "accepted": { "const": true }, "signedBy": { "type": "string", "minLength": 1 }, "signedAt": { "$ref": "#/$defs/timestamp" } } },
    "cases": { "type": "array", "minItems": 25, "maxItems": 25, "items": { "type": "object", "additionalProperties": false, "required": ["id", "status", "attestedBy", "timestamp", "evidenceSha256"], "properties": { "id": { "type": "string", "minLength": 1 }, "status": { "const": "pass" }, "attestedBy": { "type": "string", "minLength": 1 }, "timestamp": { "$ref": "#/$defs/timestamp" }, "evidenceSha256": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/hash" } } } } },
    "attestation": { "type": "object", "additionalProperties": false, "required": ["signedBy", "signedAt", "statement"], "properties": { "signedBy": { "type": "string", "minLength": 1 }, "signedAt": { "$ref": "#/$defs/timestamp" }, "statement": { "type": "string", "minLength": 20 } } }
  },
  "$defs": { "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "timestamp": { "type": "string", "format": "date-time" } },
  "additionalProperties": false
}
