{
  "name": "lyricslab-mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "expo": "~56.0.12",
    "expo-asset": "~56.0.17",
    "expo-constants": "~56.0.18",
    "expo-crypto": "~56.0.4",
    "expo-dev-client": "~56.0.22",
    "expo-file-system": "~56.0.8",
    "expo-linking": "~56.0.14",
    "expo-router": "~56.2.11",
    "expo-sqlite": "~56.0.5",
    "expo-status-bar": "~56.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-webview": "13.16.1"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/react": "~19.2.2",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.11",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "build:editor-html": "npm --prefix packages/editor-web run build && node scripts/build-editor-html.mjs",
    "check:editor-html": "npm --prefix packages/editor-web run build && node scripts/build-editor-html.mjs --check",
    "build:rhyme-artifact": "node scripts/build-cmu-artifact.mjs",
    "check:rhyme-artifact": "node scripts/build-cmu-artifact.mjs --check",
    "build:rhyme-data": "node scripts/build-rhyme-data.mjs",
    "check:rhyme-data": "node scripts/build-rhyme-data.mjs --check",
    "build:rhyme-data:production": "node scripts/build-rhyme-data.mjs --manifest data/rhyme-production-manifest.json --output assets/rhyme/production.rhymebin",
    "check:rhyme-data:production": "node scripts/build-rhyme-data.mjs --check --manifest data/rhyme-production-manifest.json --output assets/rhyme/production.rhymebin",
    "check:rhyme-sources": "node scripts/check-rhyme-sources.mjs",
    "acquire:rhyme-production-sources": "node scripts/acquire-production-rhyme-sources.mjs",
    "check:rhyme-production-sources": "node scripts/acquire-production-rhyme-sources.mjs --check",
    "evaluate:rhyme-sources": "node scripts/evaluate-rhyme-sources.mjs",
    "seal:rhyme-evaluation": "node scripts/seal-rhyme-evaluation.mjs --setup",
    "check:rhyme-evaluation-seal": "node scripts/seal-rhyme-evaluation.mjs --check",
    "test:rhyme-evaluation-seal": "node scripts/test-rhyme-evaluation-seal.mjs",
    "test:rhyme-evaluation": "node scripts/evaluate-rhyme-sources.mjs --self-test",
    "test:rhyme-sources": "node scripts/test-rhyme-sources.mjs",
    "test:rhyme-data-compiler": "node scripts/test-rhyme-data.mjs",
    "test:rhyme-production-sources": "node scripts/test-production-rhyme-sources.mjs",
    "test:rhyme-production-data": "node scripts/test-production-rhyme-data.mjs",
    "test:rhyme-production-runtime": "node --expose-gc ./node_modules/jest/bin/jest.js --runInBand --testMatch '**/__production_tests__/**/*.test.ts'",
    "smoke:rhyme-artifact": "npm run check:rhyme-artifact && node scripts/smoke-cmu-rhyme-artifact.mjs",
    "perf:rhyme-ranking": "node scripts/perf-rhyme-ranking.mjs",
    "editor:build": "npm --prefix packages/editor-web run build",
    "editor:test": "npm --prefix packages/editor-web test",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ]
  },
  "private": true
}
